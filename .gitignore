# ==============================================================================
coverage/
.nyc_output/
.lcov
*.lcov
reports/
test-results/
.eslintcache
.stylelintcache
.prettiercache
.tsbuildinfo

# ==============================================================================
# 5. DIAGNOSTICS, LOGS & PROCESS CRASH TRACES
# ==============================================================================
logs/
log/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
core.*
hs_err_pid*
*.stackdump

# ==============================================================================
# 6. DATABASE STORAGE, DUMPS & GENERATED MIGRATION LOCKS
# ==============================================================================
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-shm
*.db-wal
*.sql.gz
*.sql.tar.gz
*.dump
server/prisma/migrations/**/migration.sql
prisma/migration_lock.toml

# ==============================================================================
# 7. TEMPORARY FILES, CACHE & SYSTEM SCRATCHPADS
# ==============================================================================
tmp/
temp/
.tmp/
.temp/
.cache/
.parcel-cache/
.turbo/
.rollup.cache/
.swc/
*.swp
*.swo
*~
*.bak
*.old

# ==============================================================================
# 8. OPERATING SYSTEM ARTIFACTS & METADATA
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ==============================================================================
# 9. IDE, EDITOR & LOCAL WORKSPACE CONFIGURATIONS
# ==============================================================================
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.code-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/
.c9/

# ==============================================================================
# 10. LARGE BINARIES & COMPRESSED ASSETS (PREVENT REPO BLOAT)
# ==============================================================================
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.iso
*.dmg
*.exe
*.msi
*.jar
*.war

# ==============================================================================
# 11. PROCESS IDENTIFIERS & LOCKS
# ==============================================================================
pids/
*.pid
*.seed
*.pid.lock

