# ==============================================================================
# 1. ENVIRONMENT VARIABLES & CREDENTIAL LEAK PREVENTION (CRITICAL)
# ==============================================================================
# Wildcard and specific block for all environment definition files
.env
.env*
*.env
*.env.local
*.env.development
*.env.test
*.env.staging
*.env.production
*.env.deploy
*.env.backup
*.env.bak
*.env.example.local
.envrc
.env.vault

# Service tokens, OAuth, private credentials
*credentials*.json
*service-account*.json
firebase-adminsdk*.json
gcloud-key*.json
client_secrets*.json
id_rsa*
id_ecdsa*
id_ed25519*
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.crt
*.cer
*.der
*.p8
*.pub.key
*.secret
.secret
secrets/
.secrets/
*.sops.yaml
*.sops.yml

# Package manager authentication and tokens
.npmrc
.yarnrc
.yarnrc.yml
auth.json
.dockercfg
.docker/config.json

# ==============================================================================
